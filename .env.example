# Dayflow does not require a .env file — no API keys or secrets.
# Copy to .env only if you need dev-server tweaks (all optional).

# Phone cannot reach your Mac on LAN? Set your machine's LAN IP, then restart Expo.
# REACT_NATIVE_PACKAGER_HOSTNAME=192.168.1.42

# Force tunnel mode without typing the flag (slower, works across networks):
# EXPO_TUNNEL=1
